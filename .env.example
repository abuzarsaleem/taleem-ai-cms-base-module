# Application
NODE_ENV=development
APP_PORT=3000
APP_NAME=Taleem AI Base Module
API_PREFIX=api/v1

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:xJkgybXAs0M2naBi@db.cqqqlsgupyqiwtdgebof.supabase.co:5432/postgres
DATABASE_HOST=db.cqqqlsgupyqiwtdgebof.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=[YOUR-PASSWORD]
DATABASE_NAME=postgres
DATABASE_SCHEMA=taleem-ai-base
DATABASE_SSL=true
DATABASE_LOGGING=false

# Local Docker PostgreSQL (optional fallback)
POSTGRES_USER=taleem
POSTGRES_PASSWORD=taleem_secret
POSTGRES_DB=taleem_platform
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT / Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Set to false in production to require invitation-based signup
AUTH_REGISTRATION_ENABLED=true
# When true, login is blocked until email is verified
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Send verification email after self-registration (invitations still auto-verify)
AUTH_SEND_VERIFICATION_ON_REGISTER=true
AUTH_VERIFICATION_TOKEN_TTL_HOURS=24
AUTH_PASSWORD_RESET_TOKEN_TTL_HOURS=1
AUTH_EMAIL_VERIFICATION_URL_BASE=http://localhost:3000/verify-email
AUTH_PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password

# Google social login (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/google/callback

# OAuth authorization server
OAUTH_ISSUER=http://localhost:3000/api/v1
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
OAUTH_SESSION_TTL_SECONDS=604800

# File storage — Backblaze B2
STORAGE_DRIVER=b2
LOCAL_STORAGE_PATH=data/files
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760

S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY=your-b2-application-key-id
S3_SECRET_KEY=your-b2-application-key
S3_BUCKET=taleem-alumni
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URLS=true
S3_SIGNED_URL_TTL_SECONDS=604800
S3_PUBLIC_URL=https://f005.backblazeb2.com/file/taleem-alumni

# Platform email — Brevo (transactional)
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=Taleem AI <noreply@yourdomain.com>

# Tenant admin invitations
INVITATION_TTL_HOURS=168
INVITATION_ACCEPT_URL_BASE=http://localhost:3000/accept-invite
