# IAM base-api (tenant workspace talks to base-module, not CMS)
VITE_API_URL=http://localhost:3010/api/v1

# alumni-web OAuth client (must match oauth_clients row + CMS OAUTH_* )
VITE_OAUTH_CLIENT_ID=alumni-web
VITE_OAUTH_CLIENT_SECRET=AlumniClientSecret2026!

# Portal callback URLs registered on the OAuth client
# Local:
VITE_ALUMNI_PORTAL_CALLBACK=http://localhost:5173/callback
VITE_ADMIN_PORTAL_CALLBACK=http://localhost:5174/callback

# Production (set on the taleem-tenant Vercel project, then redeploy):
# VITE_API_URL=https://YOUR-BASE-API.example.com/api/v1
# VITE_ALUMNI_PORTAL_CALLBACK=https://taleem-ai-cms.vercel.app/callback
# VITE_ADMIN_PORTAL_CALLBACK=https://YOUR-ADMIN.vercel.app/callback
#
# If VITE_ALUMNI_PORTAL_CALLBACK is omitted in a production build, the app
# defaults to https://taleem-ai-cms.vercel.app/callback
