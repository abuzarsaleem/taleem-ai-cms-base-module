# IAM base-api (tenant workspace talks to base-module, not CMS)
VITE_API_URL=http://localhost:3010/api/v1

# Alumni Portal OAuth client (alumni-web → ALUMNI)
VITE_OAUTH_CLIENT_ID=alumni-web
VITE_OAUTH_CLIENT_SECRET=AlumniClientSecret2026!
VITE_ALUMNI_PORTAL_URL=http://localhost:5173

# Alumni Admin OAuth client (alumni-admin → ALUMNI_ADMIN)
VITE_ADMIN_OAUTH_CLIENT_ID=alumni-admin
VITE_ADMIN_OAUTH_CLIENT_SECRET=AlumniAdminClientSecret2026!
VITE_ADMIN_PORTAL_URL=http://localhost:5174

# Production (set on the taleem-tenant Vercel project, then redeploy):
# VITE_API_URL=https://taleem-ai-cms-base-module-production.up.railway.app/api/v1
# VITE_ALUMNI_PORTAL_URL=https://taleem-ai-cms.vercel.app
# VITE_ADMIN_PORTAL_URL=https://taleem-ai-admin.vercel.app
#
# Production builds default to those Vercel origins if env is omitted.
